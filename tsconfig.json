{
  "include": [
    "client/src/**/*",
    "shared/**/*",
    "server/**/*",
    "api/**/*",
    "apps/**/*",
    "packages/**/*"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "**/*.test.ts"
  ],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "strict": true,
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",

    "paths": {
      "@/*": [
        "./client/src/*"
      ],
      "@shared/*": [
        "./shared/*"
      ],
      "@cbt/shared-types": [
        "./packages/shared-types/src/index.ts"
      ],
      "@cbt/shared-ui": [
        "./packages/shared-ui/src/index.ts"
      ],
      "@cbt/shared-api-client": [
        "./packages/shared-api-client/src/index.ts"
      ],
      "@cbt/shared-realtime": [
        "./packages/shared-realtime/src/index.ts"
      ]
    }
  }
}