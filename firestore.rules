rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Isolated exam answers cache for student portal
    match /examAnswers/{answerDocId} {
      // Reject writes if current request time exceeds official exam end time
      allow read, write: if (resource != null && request.time < resource.data.examEndTime)
        || (resource == null && request.time < request.resource.data.examEndTime);
    }

    // Default deny all other collections unless authenticated
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
